rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para comprobar si el usuario es el dueño del evento
    function isEventOwner(eventId) {
      return request.auth != null && 
        request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid;
    }

    // Reglas para la colección principal 'events'
    match /events/{eventId} {
      // Público: cualquiera puede leer los detalles del evento (para ver portada, nombres, etc.)
      allow read: if true;
      
      // Solo usuarios autenticados pueden crear eventos si se asignan como ownerUid
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      
      // Solo el dueño puede editar o borrar el evento
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Subcolección 'gifts' (regalos del evento)
      match /gifts/{giftId} {
        // Público: cualquiera puede leer la lista de regalos
        allow read: if true;

        // Solo el dueño puede agregar nuevos regalos o eliminarlos
        allow create, delete: if isEventOwner(eventId);

        // Actualización:
        // 1. El dueño puede modificar cualquier campo del regalo
        // 2. Un invitado NO autenticado puede descontar unidades ATÓMICAMENTE durante un reclamo (claim):
        //    - Solo se puede modificar el campo 'quantityRemaining'
        //    - Ningún otro campo del regalo puede cambiar
        //    - El nuevo 'quantityRemaining' debe ser exactamente menor al anterior y nunca negativo
        allow update: if isEventOwner(eventId) || (
          // El invitado solo actualiza quantityRemaining
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantityRemaining']) &&
          request.resource.data.quantityRemaining is int &&
          request.resource.data.quantityRemaining >= 0 &&
          request.resource.data.quantityRemaining < resource.data.quantityRemaining
        );
      }

      // Subcolección 'claims' (regalos confirmados por invitados)
      match /claims/{claimId} {
        // Lectura pública de claims permitida para mostrar quién reservó cada regalo
        allow read: if true;

        // Crear claim: Un invitado puede registrar su regalo
        // Debe incluir guestName (mínimo 2 caracteres), giftId, quantity (mínimo 1), giftName y createdAt
        allow create: if request.resource.data.giftId is string &&
          request.resource.data.giftName is string &&
          request.resource.data.guestName is string &&
          request.resource.data.guestName.size() >= 2 &&
          request.resource.data.quantity is int &&
          request.resource.data.quantity >= 1;

        // Anular / eliminar claim: Solo los papás pueden anular un reclamo
        allow delete: if isEventOwner(eventId);
        allow update: if false; // Los reclamos no se editan directamente
      }
    }
  }
}
